! Configuration for Switch {{ device.id }}
! Generated by TopoGemma
enable
configure terminal
hostname {{ device.id }}
no ip domain-lookup

{% if vlans %}
! VLAN Configuration
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
 exit
{% endfor %}
{% endif %}

! Port Configurations
{% for port in ports %}
interface {{ port.name }}
{% if port.mode == 'trunk' %}
 switchport mode trunk
 switchport trunk allowed vlan all
{% elif port.mode == 'access' %}
 switchport mode access
{% if port.vlan_id %}
 switchport access vlan {{ port.vlan_id }}
{% endif %}
 spanning-tree portfast
{% endif %}
 no shutdown
 exit
{% endfor %}

{% if management_svi %}
! Management SVI
interface Vlan {{ management_svi.vlan_id }}
 ip address {{ management_svi.ip }} {{ management_svi.mask }}
 no shutdown
 exit
{% if management_svi.gateway %}
ip default-gateway {{ management_svi.gateway }}
{% endif %}
{% endif %}

line con 0
 logging synchronous
 exit
line vty 0 4
 login
 exit

end
write memory
