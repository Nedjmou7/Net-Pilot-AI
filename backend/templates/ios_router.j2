! Configuration for Router {{ device.id }}
! Generated by TopoGemma
enable
configure terminal
hostname {{ device.id }}
no ip domain-lookup

{% if services.dhcp %}
! DHCP Pools
{% for pool in services.dhcp %}
ip dhcp excluded-address {{ pool.default_router }}
ip dhcp pool {{ pool.pool_name }}
 network {{ pool.network }} {{ pool.mask }}
 default-router {{ pool.default_router }}
{% if pool.dns_server %}
 dns-server {{ pool.dns_server }}
{% endif %}
 exit
{% endfor %}
{% endif %}

! Interface Configurations
{% for iface in interfaces %}
interface {{ iface.name }}
{% if iface.is_subinterface %}
 encapsulation dot1Q {{ iface.vlan_id }}
{% endif %}
{% if iface.ip and iface.mask %}
 ip address {{ iface.ip }} {{ iface.mask }}
{% endif %}
 no shutdown
 exit
{% endfor %}

{% if routing and routing.protocol != 'none' %}
! Routing Configuration
{% if routing.protocol == 'ospf' %}
router ospf {{ routing.process_id or 1 }}
{% for net in routing_networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ routing.area or 0 }}
{% endfor %}
 exit
{% elif routing.protocol == 'rip' %}
router rip
 version 2
 no auto-summary
{% for net in routing_networks %}
 network {{ net.network }}
{% endfor %}
 exit
{% endif %}
{% endif %}

{% if services.nat %}
! NAT Configuration
interface {{ services.nat.inside_interface }}
 ip nat inside
 exit
interface {{ services.nat.outside_interface }}
 ip nat outside
 exit
access-list 1 permit any
ip nat inside source list 1 interface {{ services.nat.outside_interface }} overload
{% endif %}

{% if services.acls %}
! Access Control Lists
{% for acl in services.acls %}
{% for rule in acl.rules %}
access-list {{ acl.id }} {{ rule }}
{% endfor %}
{% if acl.applied_to and acl.applied_to.device == device.id %}
interface {{ acl.applied_to.interface }}
 ip access-group {{ acl.id }} {{ acl.applied_to.direction }}
 exit
{% endif %}
{% endfor %}
{% endif %}

line con 0
 logging synchronous
 exit
line vty 0 4
 login
 exit

end
write memory
