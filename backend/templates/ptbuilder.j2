// PTBuilder JavaScript Script for Cisco Packet Tracer
// Generated by TopoGemma: {{ topology.name }}
// Copy and execute within Cisco Packet Tracer Script Modules / PTBuilder

(function() {
    print("=== Starting TopoGemma Packet Tracer Deployment ===");

    // 1. Create Devices
    print("Creating devices...");
{% for dev in topology.devices %}
    addDevice("{{ dev.id }}", "{{ dev.model }}", {{ dev.x | int }}, {{ dev.y | int }});
{% endfor %}

    // 2. Create Links
    print("Connecting links...");
{% for link in topology.links %}
    addLink("{{ link.a }}", "{{ link.a_port }}", "{{ link.b }}", "{{ link.b_port }}", "{{ link.cable }}");
{% endfor %}

    // 3. Configure PC and Server IP addresses
    print("Configuring end-device IP settings...");
{% for pc in end_devices %}
    configurePcIp("{{ pc.id }}", {{ 'true' if pc.is_dhcp else 'false' }}, "{{ pc.ip }}", "{{ pc.mask }}", "{{ pc.gateway }}");
{% endfor %}

    // 4. Apply IOS CLI configurations
    print("Deploying IOS configurations to routers and switches...");
{% for dev_id, config in cli_configs.items() %}
    configureIosDevice("{{ dev_id }}", {{ config | tojson }});
{% endfor %}

    print("=== TopoGemma deployment completed successfully! ===");
})();
